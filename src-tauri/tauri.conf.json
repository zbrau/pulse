{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "0.1.0",
  "identifier": "com.pulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pulse",
        "width": 1400,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/yt-dlp.exe"],
    "shortDescription": "Enfoque, pomodoro y música",
    "longDescription": "Pulse combina tareas, pomodoro, radio lofi y YouTube Music con letras sincronizadas en una sola ventana de escritorio."
  }
}
